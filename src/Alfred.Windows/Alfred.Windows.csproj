<Project Sdk="Microsoft.NET.Sdk">

  <!-- Alfred for Windows: tray app with the overlay pill (spec §5). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <AssemblyName>Alfred</AssemblyName>
    <RootNamespace>Alfred.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\alfred.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Lets the Mac compile-check this project; running it needs Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Microsoft.ML.OnnxRuntime and whisper both ship native DLLs per architecture. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alfred.Core\Alfred.Core.csproj" />
    <ProjectReference Include="..\Alfred.Llm\Alfred.Llm.csproj" />
    <ProjectReference Include="..\Alfred.Speech\Alfred.Speech.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- llama.cpp: CUDA 12 on the Omen's RTX, CPU as the fallback (spec §3, §7). -->
    <PackageReference Include="LLamaSharp.Backend.Cuda12.Windows" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <!-- whisper.cpp, likewise. -->
    <PackageReference Include="Whisper.net.Runtime.Cuda.Windows" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="NAudio.WinMM" Version="3.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <!-- WPF leaves these out of the implicit usings. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\alfred.ico" />
    <Content Include="Assets\chime.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
